# Copy to .env for a local isolated demo; never commit real secrets.
# Generate distinct random strings for all secrets; use a vault in production.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
RAG_DB_OWNER_PASSWORD=replace-with-a-random-owner-password
RAG_API_KEY=replace-with-a-random-rag-service-key
EVAL_API_KEY=replace-with-a-random-evaluation-key

# Remote OpenAI generation: safely disabled until a real key is supplied.
# No model is run locally. ChatGPT Plus does not include API billing.
# Never commit a populated .env file.
RAG_GENERATION_ENABLED=false
GENERATION_API_URL=https://api.openai.com/v1
GENERATION_API_KEY=
GENERATION_MODEL=gpt-4.1-mini
GENERATION_MAX_OUTPUT_TOKENS=500
